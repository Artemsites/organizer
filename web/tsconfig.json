{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    // baseUrl не ставим: deprecated в TS 6, удалён в TS 7. paths без него — только относительные ./ или ../
    "paths": {
      "@organizer/shared": [
        "../shared/src/index.ts"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vite.proxy.ts"
  ]
}
